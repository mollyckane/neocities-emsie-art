    <!------- status section -------->
    <section class="window small" data-window style="left: 20vw; top: 29rem; z-index: 5;">
      <header class="window-header" data-drag-handle>
        <div class="window-title"><span class="window-dot"></span> status</div>
        <div class="window-controls">
          <button type="button" aria-label="Minimize">_</button>
          <button type="button" aria-label="Maximize">□</button>
          <button type="button" aria-label="Close">×</button>
        </div>
      </header>
      <!-- status box content -->
      <div class="window-body">
        <div class="status-box">
          currently thinking about: stipple textures, stars, the moon and pages that feel like rooms.
        </div>
        <ul class="mini-list" style="margin-top: 1rem;">
          <li><a href="/pages/update-log.html" target="_blank">update log</a></li>
        
        
        </ul>
      </div>
