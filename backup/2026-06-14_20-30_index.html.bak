          </div>
          <div class="player-controls">
            <button type="button" id="prevBtn">◁</button>
            <button type="button" id="nextBtn">▷</button>
            <button type="button" id="playPause">▶</button>

            <div class="player-volume-wrap">
              <label for="volume" class="volume-slider">vol</label>
              <input type="range" id="volume" min="0" max="1" step="0.01" value="0.2">    
            </div>
          </div>
          <span style="font-size:0.6rem;color:inherit;">track credits: <a href="https://freemusicarchive.org/music/pamela-yuen/contact" target="_blank">pamela yuen</a> <a href="https://freemusicarchive.org/music/john-lopker/contact" target="_blank">john lopker</a> <a href="https://freemusicarchive.org/music/mark-lingard/contact" target="_blank">mark lingard</a></span>
        </div>
