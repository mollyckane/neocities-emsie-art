    <!-------- music player section -------->
    <section class="window small" data-window style="left: 62vw; top: 9rem; z-index: 7;">
      <header class="window-header" data-drag-handle>
        <div class="window-title"><span class="window-dot"></span> player</div>
        <div class="window-controls">
          <button type="button" aria-label="Minimize">_</button>
          <button type="button" aria-label="Maximize">□</button>
          <button type="button" aria-label="Close">×</button>
        </div>
      </header>
      <div class="window-body">
        <div class="player">
          <audio id="audio" src=""></audio>
          <div class="player-track-info tooltip-music-credits">
