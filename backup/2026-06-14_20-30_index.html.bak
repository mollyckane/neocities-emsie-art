  </main>

  <!------ buttons banner -------->
  <div class="marquee-wrap" aria-label="Scrolling stamps banner">
    <div class="marquee">
      <div class="marquee-item">black tea addict</div>
      <div class="marquee-item">draggable windows</div>
      <div class="marquee-item">tiny relics & dusty links</div>
      <div class="marquee-item">UTC +1</div>
      <div class="marquee-item">old web forever</div>
      <div class="marquee-item">guestbook coming soon</div>
      <div class="marquee-item">black tea addict</div>
      <div class="marquee-item">draggable windows</div>
      <div class="marquee-item">tiny relics & dusty links</div>
      <div class="marquee-item">UTC +1</div>
      <div class="marquee-item">old web forever</div>
      <div class="marquee-item">guestbook coming soon</div>
      <div class="marquee-item"><img src="https://i.postimg.cc/pdd3rCQ5/winkingyawningbunny.gif" style="width:17px;height:23px;border:none;background:none;"></div>
    </div>
  </div>

  <script>
    (() => {
      const windows = Array.from(document.querySelectorAll('[data-window]'));
      let z = 20;

      function bringToFront(win) {
        z += 1;
        win.style.zIndex = z;
      }

      windows.forEach((win) => {
        const handle = win.querySelector('[data-drag-handle]');
        if (!handle) return;

        const controls = win.querySelectorAll('.window-controls button');
        controls.forEach((button) => {
          button.addEventListener('click', () => bringToFront(win));
        });

        win.addEventListener('mousedown', () => bringToFront(win));

        handle.addEventListener('pointerdown', (event) => {
          if (window.innerWidth <= 900) return;
          if (event.target.closest('.window-controls')) return;
          bringToFront(win);
          const rect = win.getBoundingClientRect();
          const offsetX = event.clientX - rect.left;
          const offsetY = event.clientY - rect.top;
          handle.setPointerCapture(event.pointerId);

          const move = (moveEvent) => {
            const maxX = window.innerWidth - rect.width - 12;
            const maxY = window.innerHeight - rect.height - 54;
            const nextX = Math.min(Math.max(12, moveEvent.clientX - offsetX), Math.max(12, maxX));
            const nextY = Math.min(Math.max(12, moveEvent.clientY - offsetY), Math.max(12, maxY));
            win.style.left = `${nextX}px`;
            win.style.top = `${nextY}px`;
          };

          const up = () => {
            handle.removeEventListener('pointermove', move);
            handle.removeEventListener('pointerup', up);
            handle.removeEventListener('pointercancel', up);
          };

          handle.addEventListener('pointermove', move);
          handle.addEventListener('pointerup', up);
          handle.addEventListener('pointercancel', up);
        });
      });
    })();
  </script>
  <script src="javascript/extra.js"></script>
</body>
</html>
